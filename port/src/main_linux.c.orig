/* hpcos - Recompiled Game Entry Point (Linux host)
 *
 * Linux port of templates/new-game/src/main.c. Same init sequence:
 *   1. Load default.xbe
 *   2. Initialise Xbox memory layout
 *   3. Initialise kernel replacement
 *   4. Set game directory for path translation
 *   5. Initialise kernel bridge (thunk table)
 *   6. Initialise guest stack
 *   7. Build dispatch table, arm watchdog
 *   8. Call the recompiled entry point
 *
 * Windows VEH + dbghelp crash reporting is replaced with a SIGSEGV/SIGBUS
 * handler, which also services the APU MMIO trap (RECOMP_AC97_READY) through
 * apu_hook_handle_mmio_signal before treating a fault as a crash.
 */

#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
#include <stddef.h>
#include <string.h>
#include <signal.h>
#include <ucontext.h>
#include <unistd.h>
#include <execinfo.h>
#include <sys/syscall.h>

/* xboxrecomp runtime headers */
#include <xbox/xboxrecomp.h>

/* ── Global register state (defined in xbox_memory_layout.c) ── */
extern RECOMP_TLS uint32_t g_eax, g_ecx, g_edx, g_esp;
extern RECOMP_TLS uint32_t g_ebx, g_esi, g_edi;
extern RECOMP_TLS uint32_t g_seh_ebp;
extern RECOMP_TLS double g_fp_stack[8];
extern RECOMP_TLS int g_fp_top;
extern RECOMP_TLS uint16_t g_fp_control_word;
extern RECOMP_TLS int g_fp_cmp;
extern RECOMP_TLS RecompXmm g_xmm0, g_xmm1, g_xmm2, g_xmm3;
extern RECOMP_TLS RecompXmm g_xmm4, g_xmm5, g_xmm6, g_xmm7;
extern ptrdiff_t g_xbox_mem_offset;

/* ── XBE constants ─────────────────────────────────────────── */
#define GAME_ENTRY_POINT   0x0010E698
/* Paths are relative to the directory you run the binary from */
#define GAME_XBE_PATH      "game/default.xbe"
#define GAME_DIR           "game"

/* Recompiled entry point (generated by the recomp pipeline) */
extern void xbe_entry_point(void);

/* ── Crash handler ─────────────────────────────────────────── */

static void print_guest_stack(void)
{
    if (!g_xbox_mem_offset || !g_esp)
        return;

    const uint32_t *sp =
        (const uint32_t *)((uintptr_t)g_xbox_mem_offset + g_esp);
    int shown = 0;

    fprintf(stderr, "  guest stack (return addresses, innermost first):\n");
    for (int i = 0; i < 256 && shown < 24; i++) {
        uint32_t v = sp[i];
        if (v > g_xbox_code_lo && v < g_xbox_code_hi) {
            fprintf(stderr, "    [esp+%-4d] 0x%08X\n", i * 4, v);
            shown++;
        }
    }
    if (!shown) {
        fprintf(stderr, "    (no return addresses in range)\n");
        for (int i = 0; i < 20; i++)
            fprintf(stderr, "    raw[esp+%-4d] 0x%08X\n", i * 4, sp[i]);
    }
}

/* The emulated APU (see templates/new-game/src/main.c). Declared rather than
 * included so this does not depend on src/apu being on the include path. */
typedef struct MCPXAPUState MCPXAPUState;
extern MCPXAPUState *mcpx_apu_init_standalone(uint8_t *ram_ptr);
extern MCPXAPUState *g_apu_state;
extern bool apu_hook_handle_mmio_signal(void *uctx, uint32_t fault_xbox_va);

/* The span MemoryLayoutInit leaves PROT_NONE under RECOMP_AC97_READY. */
#define APU_TRAP_BASE 0xFE800000u
#define APU_TRAP_END  0xFE830000u

static void crash_handler(int sig, siginfo_t *si, void *uctx)
{
    ucontext_t *uc = (ucontext_t *)uctx;
    uintptr_t fault_addr = (uintptr_t)si->si_addr;
    uintptr_t rip = (uintptr_t)uc->uc_mcontext.gregs[REG_RIP];

    /* An APU register access: emulate it and resume past the instruction. */
    if (sig == SIGSEGV && g_xbox_mem_offset && g_apu_state) {
        uint32_t va = (uint32_t)(fault_addr - (uintptr_t)g_xbox_mem_offset);
        if (va >= APU_TRAP_BASE && va < APU_TRAP_END
                && apu_hook_handle_mmio_signal(uctx, va))
            return;
    }

    fprintf(stderr, "\n[CRASH] %s at RIP=0x%llX, fault addr=0x%llX\n",
            sig == SIGSEGV ? "SIGSEGV" : (sig == SIGBUS ? "SIGBUS" : "signal"),
            (unsigned long long)rip, (unsigned long long)fault_addr);
    fprintf(stderr, "  Xbox regs: eax=0x%08X ecx=0x%08X edx=0x%08X esp=0x%08X\n",
            g_eax, g_ecx, g_edx, g_esp);
    fprintf(stderr, "  Xbox regs: ebx=0x%08X esi=0x%08X edi=0x%08X\n",
            g_ebx, g_esi, g_edi);
    if (g_xbox_mem_offset)
        fprintf(stderr, "  Xbox VA of fault: 0x%08X\n",
                (uint32_t)(fault_addr - (uintptr_t)g_xbox_mem_offset));

    print_guest_stack();

    /* Native backtrace: sub_XXXXXXXX names appear if linked with -rdynamic */
    {
        void *frames[32];
        int n = backtrace(frames, 32);
        fprintf(stderr, "  native backtrace:\n");
        backtrace_symbols_fd(frames, n, STDERR_FILENO);
    }
    fflush(stderr);

    /* Re-raise with the default action so you still get a core dump */
    signal(sig, SIG_DFL);
    raise(sig);
}

/* SIGUSR2: print the main thread's native stack without stopping it
 * (gdb cannot run this title: the AC97 trap single-steps with SIGTRAP).
 * A process-directed signal lands on any thread, so forward it to main. */
static void sample_handler(int sig)
{
    (void)sig;
    if (gettid() != getpid()) {
        syscall(SYS_tgkill, getpid(), getpid(), SIGUSR2);
        return;
    }
    void *frames[24];
    int n = backtrace(frames, 24);
    static const char hdr[] = "[SAMPLE] main thread:\n";
    write(STDERR_FILENO, hdr, sizeof(hdr) - 1);
    backtrace_symbols_fd(frames + 2, n - 2, STDERR_FILENO);
}

static void install_crash_handler(void)
{
    /* Separate signal stack so a blown native stack can still report */
    static uint8_t alt_stack[64 * 1024];
    stack_t ss;
    ss.ss_sp = alt_stack;
    ss.ss_size = sizeof(alt_stack);
    ss.ss_flags = 0;
    sigaltstack(&ss, NULL);

    struct sigaction sa;
    memset(&sa, 0, sizeof(sa));
    sa.sa_sigaction = crash_handler;
    sa.sa_flags = SA_SIGINFO | SA_ONSTACK;
    sigemptyset(&sa.sa_mask);
    sigaction(SIGSEGV, &sa, NULL);
    sigaction(SIGBUS, &sa, NULL);
    sigaction(SIGILL, &sa, NULL);
    sigaction(SIGFPE, &sa, NULL);

    struct sigaction ss2;
    memset(&ss2, 0, sizeof(ss2));
    ss2.sa_handler = sample_handler;
    ss2.sa_flags = SA_RESTART;
    sigemptyset(&ss2.sa_mask);
    sigaction(SIGUSR2, &ss2, NULL);
}

/* ── XBE loading ───────────────────────────────────────────── */

static bool load_xbe(const char *path, void **out_data, size_t *out_size)
{
    FILE *f = fopen(path, "rb");
    if (!f) {
        fprintf(stderr, "Cannot open XBE: %s\n", path);
        return false;
    }

    fseek(f, 0, SEEK_END);
    long size = ftell(f);
    fseek(f, 0, SEEK_SET);
    if (size <= 0) {
        fclose(f);
        return false;
    }

    void *data = malloc((size_t)size);
    if (!data) {
        fclose(f);
        return false;
    }

    if (fread(data, 1, (size_t)size, f) != (size_t)size) {
        free(data);
        fclose(f);
        return false;
    }

    fclose(f);
    *out_data = data;
    *out_size = (size_t)size;
    return true;
}

/* ── main ──────────────────────────────────────────────────── */

int main(int argc, char **argv)
{
    void *xbe_data = NULL;
    size_t xbe_size = 0;
    (void)argc;
    (void)argv;

    setvbuf(stdout, NULL, _IONBF, 0);
    setvbuf(stderr, NULL, _IONBF, 0);

    printf("=== hpcos - Static Recompilation (Linux) ===\n");

    install_crash_handler();

    /* Step 1: Load XBE */
    printf("Loading XBE...\n");
    if (!load_xbe(GAME_XBE_PATH, &xbe_data, &xbe_size)) {
        fprintf(stderr, "Failed to load %s. Put the game files in '%s/'.\n",
                GAME_XBE_PATH, GAME_DIR);
        return 1;
    }
    printf("XBE loaded: %zu bytes\n", xbe_size);

    /* Step 2: Memory layout */
    printf("Initializing Xbox memory layout...\n");
    if (!xbox_MemoryLayoutInit(xbe_data, xbe_size)) {
        fprintf(stderr, "Failed to initialize Xbox memory layout "
                        "(required address range unavailable?)\n");
        free(xbe_data);
        return 1;
    }
    g_xbox_mem_offset = xbox_GetMemoryOffset();
    printf("Xbox memory mapped. Offset: 0x%llX\n",
           (unsigned long long)g_xbox_mem_offset);

    /* The emulated APU, behind the same variable that unmaps its registers:
     * the trap and the model are no use apart. It walks guest RAM for voice
     * buffers, so it gets the guest RAM base. */
    if (getenv("RECOMP_AC97_READY")) {
        g_apu_state = mcpx_apu_init_standalone((uint8_t *)xbox_GetMemoryBase());
        fprintf(stderr, "[BOOT] emulated APU %s\n",
                g_apu_state ? "up" : "FAILED to initialise");
    }

    /* Step 3: Kernel */
    printf("Initializing Xbox kernel replacement...\n");
    xbox_kernel_init();

    /* Step 4: Game directory for path translation */
    {
        extern void xbox_path_init(const char *game_dir, const char *save_dir);
        xbox_path_init(GAME_DIR, NULL);
    }

    /* Step 5: Kernel bridge */
    printf("Initializing kernel bridge...\n");
    xbox_kernel_bridge_init();

    /* GPU fence. D3D's push-buffer wait (guest 0x00135AD0) spins until the
     * time stamp the GPU has completed -- *(dev+0x30) points at it -- catches
     * up with the one it last inserted at dev+0x2C. Nothing here runs a GPU to
     * write it, so mirror the inserted stamp into it. The device pointer is
     * the global D3D CreateDevice stores at 0x00140888. */
    xbox_Nv2aMirrorFence(0x00140888u, 0x2Cu, 0x30u);

    /* Step 6: Guest stack */
    g_esp = XBOX_STACK_TOP;

    printf("\n=== Initialization complete ===\n");
    printf("Entry point: 0x%08X\n", GAME_ENTRY_POINT);
    printf("ESP: 0x%08X\n", g_esp);

    /* Flat dispatch table (optional; falls back to binary search) */

    /* Hang watchdog (active only if RECOMP_WATCHDOG_SECS is set) */
    xbox_WatchdogStart();

    /* Step 7: Run the game */
    printf("\nStarting game...\n");
    xbe_entry_point();

    printf("\nGame returned. Cleaning up...\n");
    xbox_kernel_shutdown();
    xbox_MemoryLayoutShutdown();
    free(xbe_data);
    return 0;
}
